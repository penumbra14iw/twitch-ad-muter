{
  "manifest_version": 3,
  "name": "Twitch Ad Muter — Early Audio Control Build",
  "version": "0.2.0",
  "description": "Mutes the Twitch tab for an observed ad UI signal and restores it when that signal clears.",
  "permissions": ["tabs", "storage"],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.twitch.tv/*", "https://twitch.tv/*"],
      "js": ["shared/detection-core.js", "content/detector.js"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": ["https://www.twitch.tv/*", "https://twitch.tv/*"]
}
